# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI RESEARCH ASSISTANT - ENVIRONMENT CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━ LLM & SEARCH CONFIGURATION ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Choose either OpenAI or Google Gemini

# For Google Gemini (recommended for intranet, LLM API only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
MODEL_NAME=gemini-2.5-pro

# For OpenAI models (alternative provider)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your_openai_api_key_here
# MODEL_NAME=gpt-4o-mini

# Temperature for response generation (0.0-2.0, lower = more deterministic)
TEMPERATURE=0.3

# Web search configuration
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ━━━ AUTHENTICATION & JWT ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Must be at least 32 characters long for security
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_here

# JWT algorithm (HS256, RS256, etc.)
JWT_ALGORITHM=HS256

# JWT expiry time in seconds (86400 = 24 hours)
JWT_EXPIRY=86400

# ━━━ DATABASE CONFIGURATION ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://research_user:your_secure_password@localhost:5432/research_agent_db

# ━━━ RAG & MEMORY STORAGE ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ChromaDB configuration (legacy, still used for session memory)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_SESSIONS_DIR=./chroma_db/sessions
CHROMA_RAG_DIR=./chroma_db/rag

# PageIndex RAG Configuration (self-hosted, no API key required)
# Workspace directory for hierarchical document indexing with OCR
PAGEINDEX_WORKSPACE=./pageindex_data
# LLM model for PageIndex tree generation (defaults to MODEL_NAME if not set)
PAGEINDEX_MODEL=gpt-4o-mini

# Embedding models (only used if ChromaDB is still in use for other purposes)
# For OpenAI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# For Google
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# ━━━ SERVER CONFIGURATION ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FastAPI server
HOST=0.0.0.0
PORT=8000

# Streamlit UI
UI_HOST=localhost
UI_PORT=8001

# API URL for UI to connect to
API_URL=http://localhost:8000

# Mode: 'api' (FastAPI only), 'ui' (Streamlit only), or 'both'
MODE=both

# Development mode (enables hot reload)
RELOAD=false

# ━━━ RESEARCH CONFIGURATION ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Maximum iterations for research agents
MAX_ITERATIONS=5

# Quality score threshold (0.0-1.0) for accepting results
QUALITY_THRESHOLD=0.75

# ━━━ LOGGING & MONITORING ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# ━━━ DEPLOYMENT ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Railway/Cloud deployment secrets
RAILWAY_ENVIRONMENT_NAME=development
